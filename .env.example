# Kopieren nach .env und Werte setzen
POSTGRES_DB=liqui
POSTGRES_USER=liqui
POSTGRES_PASSWORD=bitte-sicheres-passwort
SECRET_KEY=bitte-langen-zufallswert-setzen        # z. B.: openssl rand -hex 32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern
DEMO_DATEN=true
APP_PORT=8000

# Belegablage für Bestelldateien: ohne Angabe Docker-Volume „ablage“;
# alternativ ein Host-Pfad (z. B. eingebundene Netzfreigabe): ABLAGE_HOST_PFAD=/mnt/belege
ABLAGE_HOST_PFAD=
# Optional: eigener Schlüssel für gespeicherte Geheimnisse (sonst aus SECRET_KEY)
GEHEIMNIS_SCHLUESSEL=
# Optional: Geheimnisse nur hier statt in der Oberfläche (haben dann Vorrang)
GRAPH_CLIENT_SECRET=
LLM_API_KEY=
